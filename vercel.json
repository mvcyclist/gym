{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/gym",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/gym/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/gym/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/gym/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/gym/icons.svg", "destination": "/icons.svg" },
    { "source": "/gym", "destination": "/index.html" },
    { "source": "/gym/", "destination": "/index.html" },
    { "source": "/gym/(.*)", "destination": "/index.html" }
  ]
}
