# Copy to .env.local for local dev. Add the same vars in Vercel → Settings → Environment Variables.

# Project URL only — NOT the REST URL (no /rest/v1 suffix). Supabase → Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Local OAuth (required for sign-in on localhost) ---
# Supabase Dashboard → Authentication → URL Configuration:
#   • Redirect URLs: add http://localhost:5173/** and http://localhost:5174/**
#   • Site URL can stay as production; redirect URLs control where OAuth returns.
#
# Optional: force OAuth to return here (auto-detects window.location.origin if unset):
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/
