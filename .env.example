# Copy to .env.local for local dev. Add the same vars in Vercel → Settings → Environment Variables.

# Project URL only — NOT the REST URL (no /rest/v1 suffix). Supabase → Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Local OAuth (required for sign-in on localhost) ---
# Supabase Dashboard → Authentication → URL Configuration:
#   • Redirect URLs: add http://localhost:5173/** and http://localhost:5174/**
#   • Site URL can stay as production; redirect URLs control where OAuth returns.
#
# Optional sign-in password (for npm run inspect:workouts)
# GYM_USER_EMAIL=you@example.com
# GYM_USER_PASSWORD=your-password

# Optional admin inspect (Supabase → Settings → API → service_role — never commit)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GYM_USER_ID=your-auth-user-uuid

# --- Guided audio publish (scripts/publish-guided-routine.mjs only — NOT used by the app) ---
# ElevenLabs → Profile → API Keys
ELEVENLABS_API_KEY= sk_47fba6f1a95bcffd3b59cc48cdc928e8c2e9b94a6e7975ac
# ElevenLabs → Voices → click voice → copy Voice ID (or: npm run publish:guided -- --list-voices)
ELEVENLABS_VOICE_ID=c6SfcYrb2t09NHXiT80T
# Optional — default: eleven_turbo_v2_5 (avoid eleven_v3 with SSML scripts)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_STABILITY=0.55
# ELEVENLABS_SIMILARITY_BOOST=0.8
